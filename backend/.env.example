# ==============================================================================
# LA PLANTA PRIME • STANDALONE BACKEND CONFIGURATION
# ==============================================================================

# HTTP API Server Port
PORT=4000

# Raw TCP GPS Telematics Listener Port (For GPRS / Cellular Tracker reporting)
PORT_TELEMATICS=5000

# Supabase Credentials (Found in Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# SMS Gateway Configuration (Optional - for SMS-based pings or VIP notifications)
# Options: 'termii' | 'africastalking' | 'simulated'
SMS_PROVIDER=termii
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=LaPlanta

# Africa's Talking (Alternative SMS Gateway)
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-api-key
